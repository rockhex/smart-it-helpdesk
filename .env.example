# Version of the n8n sandbox services
N8N_SANDBOX_VERSION=1.6.0

# Replace these placeholders with unique values for your environment
SANDBOX_API_KEYS=replace_with_your_api_key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace_with_your_registration_token
SANDBOX_API_RUNNER_API_KEY=replace_with_your_runner_api_key
