                  {
                      "parameters":  {
                                         "jsCode":  "\nconst input = $input.first().json;\nconst query = input.query ?? {};\n\nconst allowedStatuses = [\n  \u0027open\u0027,\n  \u0027in_progress\u0027,\n  \u0027resolved\u0027,\n  \u0027closed\u0027,\n];\n\nconst allowedPriorities = [\n  \u0027low\u0027,\n  \u0027medium\u0027,\n  \u0027high\u0027,\n  \u0027critical\u0027,\n];\n\nconst allowedCategories = [\n  \u0027network\u0027,\n  \u0027security\u0027,\n  \u0027software\u0027,\n  \u0027hardware\u0027,\n  \u0027access\u0027,\n  \u0027other\u0027,\n];\n\nconst errors = [];\n\nfunction validateEnum(field, allowedValues) {\n  const value = query[field];\n\n  if (value === undefined || value === \u0027\u0027) {\n    return;\n  }\n\n  if (\n    typeof value !== \u0027string\u0027 ||\n    !allowedValues.includes(value.toLowerCase())\n  ) {\n    errors.push(\n      `El parÃ¡metro \u0027${field}\u0027 no tiene un valor vÃ¡lido.`\n    );\n  }\n}\n\nvalidateEnum(\u0027status\u0027, allowedStatuses);\nvalidateEnum(\u0027priority\u0027, allowedPriorities);\nvalidateEnum(\u0027category\u0027, allowedCategories);\n\nif (\n  query.q !== undefined \u0026\u0026\n  (\n    typeof query.q !== \u0027string\u0027 ||\n    query.q.length \u003e 100\n  )\n) {\n  errors.push(\n    \"El parÃ¡metro \u0027q\u0027 debe tener como mÃ¡ximo 100 caracteres.\"\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      validationError: errors.length\n        ? errors.join(\u0027 \u0027)\n        : null,\n    },\n  },\n];\n"
                                     },
