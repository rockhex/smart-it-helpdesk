                                         "query":  "SELECT\n    id,\n    title,\n    description,\n    requester,\n    category,\n    priority,\n    summary,\n    suggested_actions,\n    requires_human_review,\n    status\nFROM tickets\nWHERE ($1::text IS NULL OR status = $1)\n  AND ($2::text IS NULL OR priority = $2)\n  AND ($3::text IS NULL OR category = $3)\n  AND (\n      $4::text IS NULL\n      OR title ILIKE \u0027%\u0027 || $4 || \u0027%\u0027\n      OR description ILIKE \u0027%\u0027 || $4 || \u0027%\u0027\n      OR summary ILIKE \u0027%\u0027 || $4 || \u0027%\u0027\n  )\nORDER BY id DESC\nLIMIT 100;",
