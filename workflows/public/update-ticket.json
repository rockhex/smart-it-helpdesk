                      "parameters":  {
                                         "jsCode":  "\nconst input = $input.first().json;\nconst params = input.params ?? {};\nconst body = input.body ?? {};\n\nconst errors = [];\nconst ticketId = Number(params.id);\n\nif (\n  !params.id ||\n  !Number.isSafeInteger(ticketId) ||\n  ticketId \u003c= 0\n) {\n  errors.push(\u0027El ID del ticket debe ser un entero positivo.\u0027);\n}\n\nconst allowedFields = [\u0027status\u0027, \u0027priority\u0027];\nconst allowedStatuses = [\n  \u0027open\u0027,\n  \u0027in_progress\u0027,\n  \u0027resolved\u0027,\n  \u0027closed\u0027,\n];\nconst allowedPriorities = [\n  \u0027low\u0027,\n  \u0027medium\u0027,\n  \u0027high\u0027,\n  \u0027critical\u0027,\n];\n\nconst suppliedFields = Object.keys(body);\n\nif (suppliedFields.length === 0) {\n  errors.push(\u0027Debe enviar al menos un campo para actualizar.\u0027);\n}\n\nfor (const field of suppliedFields) {\n  if (!allowedFields.includes(field)) {\n    errors.push(`El campo \u0027${field}\u0027 no se puede actualizar.`);\n  }\n}\n\nif (\n  body.status !== undefined \u0026\u0026\n  (\n    typeof body.status !== \u0027string\u0027 ||\n    !allowedStatuses.includes(body.status.toLowerCase())\n  )\n) {\n  errors.push(\u0027El estado enviado no es vÃ¡lido.\u0027);\n}\n\nif (\n  body.priority !== undefined \u0026\u0026\n  (\n    typeof body.priority !== \u0027string\u0027 ||\n    !allowedPriorities.includes(body.priority.toLowerCase())\n  )\n) {\n  errors.push(\u0027La prioridad enviada no es vÃ¡lida.\u0027);\n}\n\nreturn [{\n  json: {\n    ticketId,\n    update: {\n      ...(body.status !== undefined\n        ? { status: body.status.toLowerCase() }\n        : {}),\n      ...(body.priority !== undefined\n        ? { priority: body.priority.toLowerCase() }\n        : {}),\n    },\n    validationError: errors.length\n      ? errors.join(\u0027 \u0027)\n      : null,\n  },\n}];\n"
                                     },
